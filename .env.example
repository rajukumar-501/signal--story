# ==============================================================================
# Signal Story (Decision Intelligence) — Environment Configuration Template
# Copy this file to '.env' and supply your credentials if running in Live mode.
# ==============================================================================

# LLM Provider Configuration
# Supported options: 'gemini', 'mock'
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Google Gemini API Key (Required ONLY for live reasoning provider; not required for Preview/Mock mode)
GEMINI_API_KEY=

# Application Server Configuration
HOST=127.0.0.1
PORT=8000
