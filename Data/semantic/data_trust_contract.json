{
  "version": "1.0.0",
  "schema": "Accenture Enterprise Data Trust & Quality Contract Specification",
  "organization": "Accenture Decision Intelligence Platform / Signal Story",
  "evaluated_scope": "prototype_metadata",
  "datasets": {
    "fact_sales_monthly.csv": {
      "dataset_name": "fact_sales_monthly.csv",
      "business_purpose": "Canonical transactional sales records tracking gross volume, net revenue, and return deductions.",
      "expected_grain": "Monthly by Market, Customer Code, Product Code, Channel",
      "required_columns": [
        "date",
        "product_code",
        "customer_code",
        "Qty",
        "gross_qty",
        "return_qty",
        "signed_sales_amount",
        "gross_sales_amount",
        "return_sales_amount"
      ],
      "date_column": "date",
      "freshness_policy": "Monthly batch aggregation at T+1 calendar day following accounting period close",
      "expected_update_cadence": "Monthly batch",
      "null_tolerance": {
        "date": 0.0,
        "product_code": 0.0,
        "customer_code": 0.0,
        "gross_sales_amount": 0.0,
        "signed_sales_amount": 0.0
      },
      "duplicate_policy": "Zero duplicate natural keys on (date, product_code, customer_code)",
      "valid_range_rules": {
        "gross_sales_amount": ">= 0.0",
        "gross_qty": ">= 0.0",
        "return_qty": ">= 0.0"
      },
      "source_type": "ERP Financial Ledger Extraction",
      "lineage_reference": "ERP Sales System -> Data/Processed/fact_sales_monthly.csv",
      "sensitivity_classification": "Confidential - Commercial Financial Performance",
      "minimum_quality_score": 95.0,
      "trust_status_rules": {
        "TRUSTED": "Score >= 95.0 AND zero missing critical columns AND coverage complete for analysis window",
        "ACCEPTABLE": "Score >= 85.0 AND coverage complete",
        "DEGRADED": "Score < 85.0 OR minor temporal gap",
        "BLOCKED": "Dataset missing OR missing mandatory primary keys OR incomplete requested period"
      }
    },
    "fact_inventory_monthly.csv": {
      "dataset_name": "fact_inventory_monthly.csv",
      "business_purpose": "Warehouse stock levels, receipt logs, and stockout incident telemetry.",
      "expected_grain": "Monthly by Market, Product Code",
      "required_columns": [
        "date",
        "product_code",
        "market",
        "opening_stock_units",
        "received_units",
        "closing_stock_units",
        "stockout_flag",
        "stockout_hours"
      ],
      "date_column": "date",
      "freshness_policy": "Monthly inventory snapshot reconciliation",
      "expected_update_cadence": "Monthly batch",
      "null_tolerance": {
