        "product_code": 0.0,
        "market": 0.0,
        "stockout_flag": 0.0
      },
      "duplicate_policy": "Zero duplicate natural keys on (date, product_code, market)",
      "valid_range_rules": {
        "closing_stock_units": ">= 0.0",
        "stockout_hours": ">= 0.0",
        "stockout_flag": "IN [0, 1]"
      },
      "source_type": "WMS Warehouse Inventory Ledger",
      "lineage_reference": "Warehouse Management System -> Data/Processed/fact_inventory_monthly.csv",
      "sensitivity_classification": "Internal Operational Data",
      "minimum_quality_score": 95.0,
      "trust_status_rules": {
        "TRUSTED": "Score >= 95.0 AND zero stockout_flag nulls",
        "ACCEPTABLE": "Score >= 85.0",
        "DEGRADED": "Score < 85.0",
        "BLOCKED": "Dataset missing OR missing required columns"
      }
    },
